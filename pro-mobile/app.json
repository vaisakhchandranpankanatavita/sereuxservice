{
  "expo": {
    "name": "Fixzy Pro",
    "slug": "fixzy-pro",
    "scheme": "fixzypro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fixzy.pro"
    },
    "android": {
      "package": "com.fixzy.pro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive-foreground.png",
        "backgroundColor": "#141412"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fixzy Pro uses your location to show your route to the customer and share your live position while a job is in progress."
        }
      ]
    ]
  }
}
